# Express Server Configuration
PORT=4000
JWT_SECRET=mentaura-ca-secure-jwt-secret-replace-in-production

# Supabase Configuration
# Obtain these from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Use the service_role key for backend access (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
# Optional: Supabase Anon public key
SUPABASE_ANON_KEY=your-supabase-anon-key-here
