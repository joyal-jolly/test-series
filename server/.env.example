# Express Server Configuration
PORT=4000
JWT_SECRET=your_jwt_secret_key_here

# Supabase Configuration
# Obtain these from your Supabase Dashboard: Project Settings -> API
SUPABASE_URL=https://your-supabase-project.supabase.co
# Use the service_role key for backend access (bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Optional: Supabase Anon public key
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# =============================================================================
# Cloudflare R2 Storage Configuration
# =============================================================================
# Obtain these from Cloudflare Dashboard: R2 -> Manage R2 API Tokens
# 1. R2 Account ID (found on the right sidebar of the Cloudflare Dashboard overview)
R2_ACCOUNT_ID=your_cloudflare_account_id
# 2. R2 Access Key ID & Secret Access Key (generated from an R2 API Token with Object Read & Write permissions)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# 3. R2 Bucket Name (created in Cloudflare R2 Dashboard)
R2_BUCKET_NAME=ca-test-series-pdf-storage
