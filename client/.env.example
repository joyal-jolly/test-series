# If deploying the frontend and backend as two separate Cloudflare Workers,
# set this to your backend Worker URL:
# VITE_API_URL=https://ca-test-series-api.<your-subdomain>.workers.dev
#
# If deploying as a unified Worker (assets + API together via root wrangler.jsonc),
# leave VITE_API_URL blank to use relative API requests.
VITE_API_URL=
