{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ca-test-series-api",
  "main": "server/src/worker.js",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "directory": "./client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/uploads/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "test-series-files",
      "preview_bucket_name": "ca-test-series-pdf-storage-dev"
    }
  ],
  "vars": {
    "NODE_ENV": "production"
  }
}
